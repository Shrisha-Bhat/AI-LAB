import heapq

goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

def heuristic(state):
    return sum(
        state[i] != 0 and state[i] != goal[i]
        for i in range(9)
    )

def get_neighbors(state):
    neighbors = []
    zero = state.index(0)

    for move in [-3, 3, -1, 1]:
        new_pos = zero + move

        if not (0 <= new_pos < 9):
            continue

        if move == -1 and zero % 3 == 0:
            continue
        if move == 1 and zero % 3 == 2:
            continue

        new_state = list(state)
        new_state[zero], new_state[new_pos] = (
            new_state[new_pos], new_state[zero]
        )
        neighbors.append(tuple(new_state))

    return neighbors


def print_state(state):
    for i in range(0, 9, 3):
        print(state[i:i+3])


def astar(start):
    pq = [(heuristic(start), 0, start)]
    visited = set()
    parent = {start: None}
    cost = {start: 0}
    iteration = 0

    while pq:
        f, g, state = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)
        iteration += 1
        h = heuristic(state)

        print(f"\nIteration {iteration}")
        print("Current State:")
        print_state(state)
        print(f"G = {g}, H = {h}, F = {f}")

        if state == goal:
            print("\nGoal reached!")
            path = []

            while state is not None:
                path.append(state)
                state = parent[state]

            return path[::-1]

        print("\nNeighbor states:")

        for nxt in get_neighbors(state):
            if nxt in visited:
                continue

            new_g = g + 1
            new_h = heuristic(nxt)
            new_f = new_g + new_h

            print_state(nxt)
            print(f"G = {new_g}, H = {new_h}, F = {new_f}")
            print()

            if nxt not in cost or new_g < cost[nxt]:
                cost[nxt] = new_g
                parent[nxt] = state
                heapq.heappush(pq, (new_f, new_g, nxt))

    return None


start = (1, 2, 3, 4, 0, 6, 7, 5, 8)
path = astar(start)

print("\nFinal Solution Path:")

if path:
    for step, state in enumerate(path):
        print(f"\nStep {step}:")
        print_state(state)

        g = step
        h = heuristic(state)
        f = g + h

        print(f"G = {g}, H = {h}, F = {f}")
else:
    print("No solution found")
